HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stellar_indexer
# Used by the indexer container; leave unset to use the Compose postgres service.
# DATABASE_URL_DOCKER=postgresql://postgres:postgres@postgres:5432/stellar_indexer
GRAPHQL_PORT=4000
# Optional starting ledger; by default the indexer resumes from its checkpoint.
# START_LEDGER=100000
LOG_LEVEL=info
